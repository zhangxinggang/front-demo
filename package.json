{
  "name": "bricks",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "commit": "git-cz",
    "dev:comp": "pnpm --filter=\"bricks-component\" run dev",
    "dev:slash": "pnpm --filter \"slash\" dev",
    "dev:slash1": "pnpm --filter=slash run dev",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@umijs/fabric": "^4.0.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-packagejson": "^2.5.19",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "ts-node": "^10.9.1",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "typeorm": "^0.3.25"
    },
    "patchedDependencies": {
      "dumi@2.4.21": "patches/dumi@2.4.21.patch"
    }
  }
}
