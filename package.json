{
  "name": "bricks",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:slash": "pnpm --filter \"slash\" dev",
    "dev:slash1": "pnpm --filter=slash run dev",
    "dev:comp": "pnpm --filter=\"bricks-component\" run dev",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepare": "husky",
    "commit": "git-cz",
    "lint-staged": "lint-staged"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.2",
    "@commitlint/config-conventional": "^17.7.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.2.4",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "typeorm": "^0.3.25"
    },
    "patchedDependencies": {
      "dumi": "patches/dumi.patch"
    }
  }
}
